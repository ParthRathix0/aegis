# Aegis Solver Agent — environment (copy to .env; NEVER commit real secrets)

# --- Onchain ---
# RPC endpoint for the target network (local hardhat, Sepolia, or Arc testnet).
RPC_URL=
# Raw signer key used for local/dev smoke tests. In production the Circle Agent
# Stack wallet signs instead (see below) — leave this empty when using Circle.
PRIVATE_KEY=
# Deployed AegisV4 settlement contract the agent cranks.
AEGIS_ADDRESS=

# --- The Graph ---
# Subgraph Studio dev query endpoint (aegis-solver). The agent's data source.
SUBGRAPH_URL=

# --- Circle Agent Stack (Arc / native USDC settlement) ---
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
CIRCLE_WALLET_ID=
CIRCLE_WALLET_ADDRESS=
CIRCLE_WALLET_SET_ID=
# Native USDC token on the target network (settlement asset).
USDC_ADDRESS=

# --- 1inch (Plan 6, optional here) ---
ONEINCH_API_KEY=
