# Aegis Solver Agent — environment (copy to .env; NEVER commit real secrets)

# --- Onchain ---
# RPC endpoint for the target network (local hardhat, Sepolia, or Arc testnet).
RPC_URL=
# Raw signer key used for local/dev smoke tests. In production the Circle Agent
# Stack wallet signs instead (see below) — leave this empty when using Circle.
PRIVATE_KEY=
# Deployed AegisV4 settlement contract the agent cranks.
AEGIS_ADDRESS=

# --- The Graph ---
# Subgraph Studio dev query endpoint (aegis-solver). The agent's data source.
SUBGRAPH_URL=

# --- Circle Agent Stack (Arc / native USDC settlement) ---
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
CIRCLE_WALLET_ID=
CIRCLE_WALLET_ADDRESS=
CIRCLE_WALLET_SET_ID=
# Native USDC token on the target network (settlement asset).
USDC_ADDRESS=

# --- 1inch Aqua (Plan 6) — route the uncrossed batch remainder to Aqua/SwapVM ---
# Developer key from https://portal.1inch.dev (Bearer auth for the Aqua/swap quote API).
ONEINCH_API_KEY=
# Deployed AquaRouter adapter address (points at the official SwapVM entrypoint).
AQUA_ROUTER_ADDRESS=
# Base/quote token addresses of the settled batch (WETH-like / USDC-like).
BASE_ASSET=
QUOTE_ASSET=
# Chain id for the Aqua quote API + slippage floor (bps) for the onchain minOut. Defaults: 1, 100.
AQUA_CHAIN_ID=
AQUA_SLIPPAGE_BPS=
# Aqua routing activates only when AQUA_ROUTER_ADDRESS + ONEINCH_API_KEY + BASE_ASSET + QUOTE_ASSET
# are all set AND a raw PRIVATE_KEY signer is available (routeUncrossedToAqua carries calldata args).

# --- Demo seed (agentic-payments) — submit one payment intent per OPEN batch ---
# When set, the agent deposits a payment intent each fresh OPEN batch so the payment-intent
# path is visible in a live run. Needs a raw PRIVATE_KEY signer + prior ERC20 allowance for
# the spent asset. Asset the agent spends (BASE=WETH → SELL, QUOTE=USDC → BUY) and the amount
# in that asset's smallest unit. Leave unset to disable seeding.
SEED_INTENT_PAY_WITH=
SEED_INTENT_AMOUNT=
